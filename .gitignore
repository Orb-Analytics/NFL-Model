# Raw nflreadpy caches -- re-fetched fresh every CI run, no need to track.
data/raw/*.parquet

# Large snapshot file, not needed for the live pipeline.
data/processed/training_set_snapshot.xlsx

# training_set.csv grew past GitHub's 100MB hard file-size limit (175MB as
# of Aug 2026) -- a push including it is rejected outright ("GH001: Large
# files detected"), not just slow. Excluded here rather than set up via Git
# LFS; it's fully regenerable locally from 01_fetch_historical.py onward,
# so nothing is lost by not versioning it.
data/processed/training_set.csv

# Everything else in data/processed IS tracked deliberately
# (live_scoring_input.csv, live_picks.csv, live_novig_odds.csv, and every
# backtest output) -- mirrors MLB-Model committing training-set/training_set.csv
# so history is versioned in git, not just regenerated silently.

.env
__pycache__/
*.pyc
.DS_Store
